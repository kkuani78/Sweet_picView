{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sweet picView",
  "version": "1.1.0",
  "identifier": "com.sweetpicview.app",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sweet picView",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#1b1d22",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Sweet picView",
    "shortDescription": "Sweet picView 이미지 뷰어",
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "jfif",
          "png",
          "gif",
          "webp",
          "bmp",
          "avif",
          "ico"
        ],
        "name": "SweetPicView.Image",
        "description": "이미지 (Sweet picView)",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "mainBinaryName": "SweetPicView"
}