{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sweet picView",
  "version": "1.6.1",
  "identifier": "com.sweetpicview.app",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sweet picView",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#1b1d22",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Sweet picView",
    "shortDescription": "Sweet picView 이미지 뷰어",
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "jfif",
          "png",
          "gif",
          "webp",
          "bmp",
          "avif",
          "ico"
        ],
        "name": "SweetPicView.Image",
        "description": "이미지 (Sweet picView)",
        "role": "Viewer"
      },
      {
        "ext": [
          "tif",
          "tiff",
          "tga",
          "exr",
          "psd",
          "psb",
          "iff",
          "heic",
          "heif"
        ],
        "name": "SweetPicView.Pro",
        "description": "이미지 (Sweet picView)",
        "role": "Viewer"
      },
      {
        "ext": [
          "cr2",
          "cr3",
          "nef",
          "nrw",
          "arw",
          "srf",
          "sr2",
          "dng",
          "raf",
          "orf",
          "rw2",
          "pef",
          "srw"
        ],
        "name": "SweetPicView.Raw",
        "description": "RAW 사진 (Sweet picView)",
        "role": "Viewer"
      },
      {
        "ext": [
          "sref"
        ],
        "name": "SweetPicView.Board",
        "description": "Sweet Ref 보드",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "template": "installer/installer.nsi"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "SweetPicView",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1QUNDNDU3MzY5RjE1MUIKUldRYkZaODJWOFNzVllYbXJUaWhMOGtRbDArTGR0ZUh4U29ENVNFVEUrSEhLazM5bTM5SWY5eUUK",
      "endpoints": [
        "https://github.com/kkuani78/Sweet_picView/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}